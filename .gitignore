# Root gitignore for IsaacPOS Monorepo

# Environment & credentials
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Dependencies
node_modules/
backend/vendor/
frontend/node_modules/

# Build outputs
frontend/dist/
frontend/dist-ssr/
*.local

# Laravel cache & generated logs
backend/storage/*.key
backend/storage/framework/cache/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
backend/storage/logs/*
backend/bootstrap/cache/*

# IDE and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
